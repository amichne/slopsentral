module slopsentral.projection.Pi

import "Schema.pkl"

function checked(input: Schema.Input): List<Schema.Plugin> =
  if (
    input.plugins.isEmpty
      || input.plugins.toList().any((p) -> p.mcp != null)
      || input.plugins.toList().map((p) -> p.version).distinct.length != 1
      || input.plugins
        .toList()
        .flatMap((p) -> refs(p, "HOOK"))
        .map((r) -> r.name)
        .length
        != input.plugins
          .toList()
          .flatMap((p) -> refs(p, "HOOK"))
          .map((r) -> r.name)
          .distinct
          .length
  )
    throw("Pi needs one version, unique hook owners, and explicit MCP adapters")
  else
    input.plugins.toList()

function refs(p: Schema.Plugin, kind: Schema.Kind): List<Schema.Asset> =
  p.references.filter((r) -> r.type == kind)

class Resources {
  skills: List<String>
  prompts: List<String>
  extensions: List<String>
}

class Package {
  name: String
  version: String(matches(Regex("[0-9]+\\.[0-9]+\\.[0-9]+")))
  description: String
  type: "module" = "module"
  keywords: List<String> = List("pi-package")
  engines: Mapping<String, String> = new { ["node"] = ">=22.19.0" }
  pi: Resources
}

function resources(plugins: List<Schema.Plugin>, prefix: Boolean): Resources = new {
  local skillsByName =
    plugins
      .flatMap((p) -> refs(p, "SKILL"))
      .map((r) -> r.name)
      .distinct
      .sort()
  skills =
    skillsByName.map((name) ->
      "./"
        + (
          if (prefix)
            plugins.find((p) -> refs(p, "SKILL").any((r) -> r.name == name)).name + "/"
          else
            ""
        )
        + "skills/"
        + name
    )
  prompts =
    plugins
      .flatMap((p) ->
        refs(p, "AGENT")
          .map((r) ->
            "./" + (if (prefix) p.name + "/" else "") + "prompts/slopsentral-" + r.name + ".md"
          )
      )
      .sort()
  extensions =
    plugins
      .filter((p) -> !refs(p, "HOOK").isEmpty || !refs(p, "INSTRUCTION").isEmpty)
      .map((p) -> "./" + (if (prefix) p.name + "/" else "") + "native.ts")
}

function manifest(input: Schema.Input): Package = new {
  name = "slopsentral-pi"
  version = checked(input).first.version
  description = input.description
  pi = resources(checked(input), true)
}

function pluginManifest(p: Schema.Plugin): Package = new {
  name = "slopsentral-pi-" + p.name
  version = p.version
  description = p.description
  pi = resources(List(p), false)
}

class Link {
  name: Schema.Identity
  path: Schema.RelativePath
}
class Catalog {
  name: Schema.Identity
  plugins: List<Link>
}
function catalog(input: Schema.Input): Catalog = new {
  name = input.name
  plugins = checked(input).map((p) -> new Link { name = p.name; path = p.name })
}

typealias Event = "SessionStart" | "UserPromptSubmit" | "Stop"
class Hook {
  name: Schema.Identity
  event: Event
  command: String(!isEmpty)
  timeout: Int(isPositive)
}
class Adapter {
  plugin: Schema.Identity
  instructions: List<String>
  hooks: List<Hook>
}
function adapter(p: Schema.Plugin): Adapter = new {
  plugin = p.name
  instructions = refs(p, "INSTRUCTION").map((r) -> "instructions/" + r.name + ".md")
  hooks =
    refs(p, "HOOK")
      .filter((r) -> r.name != "software-engineering-context")
      .flatMap((r) ->
        (r as Schema.HookReference).hook.adapter.hooks
          .toMap()
          .entries
          .toList()
          .flatMap((entry) ->
            entry.value
              .toList()
              .flatMap((group) ->
                group.hooks
                  .toList()
                  .map((c) -> new Hook {
                    name = r.name
                    event = entry.key
                    command =
                      if (
                        group.matcher != null && group.matcher != "^(startup|resume|clear|compact)$"
                          || c.matcher != null
                      )
                        throw("Unsupported Pi hook matcher")
                      else
                        c.command
                    timeout = c.timeout ?? 30
                  })
              )
          )
      )
}
function entrypoint(p: Schema.Plugin): String =
  "import { fileURLToPath } from 'node:url';\n"
    + "import type { ExtensionAPI } from '@earendil-works/pi-coding-agent';\n"
    + "import { register } from './hooks/pi-adapter.ts';\n"
    + "export default function (pi: ExtensionAPI) { register(pi, fileURLToPath(new URL('.', import.meta.url)), "
    + (new JsonRenderer { omitNullProperties = true }).renderValue(adapter(p))
    + "); }\n"
