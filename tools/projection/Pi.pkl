module slopsentral.projection.Pi

import "Schema.pkl"

// The release selection is deliberately not a workflow profile: no hooks,
// instructions, services, or invocation restrictions are simulated in Pi.
function checked(input: Schema.Input): Schema.Plugin =
  if (input.plugins.length != 1)
    throw("Pi requires the native default selection")
  else
    let (plugin = input.plugins.toList().first)
      if (
        plugin.name != "software-engineering"
          || plugin.mcp != null
          || plugin.references.length != 1
          || plugin.references.first.type != "SKILL"
          || plugin.references.first.name != "semantic-ratchet"
      )
        throw("Pi requires only the canonical semantic-ratchet skill")
      else
        plugin

class Resources {
  skills: List<String>(length == 1)
}

class Package {
  name: "slopsentral-pi" = "slopsentral-pi"
  version: "0.1.0" = "0.1.0"
  description: String
  type: "module" = "module"
  keywords: List<String> = List("pi-package")
  engines: Mapping<String, String> = new { ["node"] = ">=22.19.0" }
  pi: Resources = new { skills = List("./software-engineering/skills/semantic-ratchet") }
}

class Link {
  name: Schema.Identity
  path: Schema.RelativePath
}

class Catalog {
  name: Schema.Identity
  plugins: List<Link>
}

class Resource {
  name: Schema.Identity
  path: Schema.RelativePath
  sha256: Schema.Digest
}

class Inventory {
  type: "PI_CONTENT_PROFILE" = "PI_CONTENT_PROFILE"
  schemaVersion: Int(this == 1) = 1
  profile: "native-default" = "native-default"
  invocation: "either" = "either"
  instructionFile: "AGENTS.md" = "AGENTS.md"
  skills: List<Resource>
  instructions: List<Resource> = List()
}

function manifest(input: Schema.Input): Package = new {
  description = checked(input).description
}

function catalog(input: Schema.Input): Catalog = new {
  name = input.name
  plugins = List(new Link { name = checked(input).name; path = checked(input).name })
}

function inventory(input: Schema.Input): Inventory = new {
  skills = List(new Resource {
    name = checked(input).references.first.name
    path = "software-engineering/skills/semantic-ratchet"
    sha256 = checked(input).references.first.sha256
  })
}
