module slopsentral.projection.Source

import "pkl:json"
import "pkl:yaml"

import "Decode.pkl"
import "Pi.pkl"
import "Schema.pkl"

// The host supplies immutable file contents and digests. Pkl owns graph decisions.
local snapshot = (new json.Parser {}).parse(read(read("prop:snapshot")))
local documents = snapshot.files.toMap()
local marketplace =
  Decode.checked(
    document("source/adaptable.marketplace.json"),
    List(
      "type",
      "schemaVersion",
      "name",
      "owner",
      "description",
      "management",
      "metadata",
      "plugins",
      "skills",
      "agents",
      "instructions",
      "hooks",
      "resources",
      "adapters",
      "externalMarketplaces",
    ),
  )
local fields = List("skills", "agents", "instructions", "hooks", "resources")
local definitions: List<Schema.Primitive> =
  fields.flatMap((field) ->
    (marketplace.getPropertyOrNull(field)?.toList() ?? List()).map((ref) -> Decode.primitive(ref))
  )

function document(path: Schema.RelativePath): Dynamic =
  (new json.Parser {}).parse(documents[path].text)

function identity(ref: Schema.Primitive): String = ref.type + "/" + ref.name

function canonical(ref: Schema.Primitive): Schema.Primitive =
  let (matches = definitions.filter((candidate) -> identity(candidate) == identity(ref)))
    if (matches.length != 1)
      throw("Primitive identity must have one canonical owner: " + identity(ref))
    else if (matches.first.path != ref.path)
      throw("Primitive differs from its canonical path: " + identity(ref))
    else
      matches.first

function dependencies(ref: Schema.Primitive): List<Schema.Primitive> =
  ref.dependsOn.toList()
    + canonical(ref).dependsOn.toList()
    + (
      if (ref.type == "HOOK")
        (document("source/" + ref.path).getPropertyOrNull("dependsOn")?.toList() ?? List()).map((
          child,
        ) -> Decode.primitive(child)
        )
      else
        List()
    )

function expand(ref: Schema.Primitive, active: Set<String>): List<Schema.Primitive> =
  if (active.contains(identity(ref)))
    throw("Dependency cycle: " + identity(ref))
  else
    List(canonical(ref))
      + dependencies(ref).flatMap((child) -> expand(child, active + Set(identity(ref))))

function closure(plugin: Dynamic): List<Schema.Primitive> =
  fields
    .flatMap((field) ->
      (plugin.getPropertyOrNull(field)?.toList() ?? List()).flatMap((raw) ->
        expand(Decode.primitive(raw), Set())
      )
    )
    .distinctBy((ref) -> identity(ref))
    .sortBy((ref) -> ref.type + "/source/" + ref.path)

function digest(path: String): Schema.Digest = snapshot.digests.getProperty(path)

function support(ref: Schema.Primitive): List<Schema.RelativePath> =
  if (ref.type != "HOOK")
    List()
  else
    document("source/" + document("source/" + ref.path).path)
      .hooks
      .toMap()
      .values
      .toList()
      .flatMap((groups) ->
        groups
          .toList()
          .flatMap((group) ->
            group.hooks
              .toList()
              .flatMap((command) ->
                command.command
                  .split(" ")
                  .filter((word) -> word.matches(Regex("hooks/[A-Za-z0-9_.-]+")))
                  .flatMap((word) ->
                    documents.keys
                      .toList()
                      .filter((path) ->
                        path == "source/" + word
                          || path == "source/" + word + ".lock"
                          || (
                            path.startsWith(
                              "source/"
                                + word.substring(0, word.lastIndexOfOrNull(".") ?? word.length)
                                + ".",
                            )
                              && path.endsWith(".json")
                              && !path.endsWith(".hook.json")
                          )
                      )
                  )
              )
          )
      )

function skill(ref: Schema.Primitive): Schema.SkillReference =
  let (text = documents["source/" + ref.path + "/SKILL.md"].text)
    if (!text.startsWith("---\n"))
      throw("Skill frontmatter is missing")
    else if (text.split("\n---").length < 2)
      throw("Skill frontmatter is incomplete")
    else
      let (header = (new yaml.Parser {}).parse(text.split("\n---").first.drop(4)) as Dynamic)
        if (header.getPropertyOrNull("name") != ref.name)
          throw("Skill name differs from its identity")
        else
          let (description = header.getPropertyOrNull("description"))
            if (!(description is String))
              throw("Skill description must be text")
            else if (description.isEmpty)
              throw("Skill description is empty")
            else
              new Schema.SkillReference {
                name = ref.name
                sourcePath = "source/" + ref.path
                sha256 = digest(sourcePath)
              }

function asset(ref: Schema.Primitive): Schema.Asset =
  let (path = "source/" + ref.path)
    if (ref.type == "SKILL")
      skill(ref)
    else if (ref.type == "RESOURCE")
      new Schema.ResourceReference {
        name = ref.name
        sourcePath = path
        sha256 = digest(path)
      }
    else if (ref.type == "INSTRUCTION")
      new Schema.InstructionReference {
        name = ref.name
        sourcePath = path
        sha256 = digest(path)
        text = documents[path].text
      }
    else if (ref.type == "AGENT")
      new Schema.AgentReference {
        name = ref.name
        sourcePath = path
        sha256 = digest(path)
        text = documents[path].text
      }
    else if (ref.type == "HOOK")
      new Schema.HookReference {
        name = ref.name
        sourcePath = path
        sha256 = digest(path)
        hook = Decode.hook((document(path)) { adapter = document("source/" + document(path).path) })
      }
    else
      throw("Unsupported primitive")

function plugin(entry: Dynamic): Schema.Plugin =
  let (
    raw =
      Decode.checked(
        document("source/plugins/" + entry.name + "/plugin.json"),
        List(
          "type",
          "schemaVersion",
          "name",
          "version",
          "description",
          "interface",
          "metadata",
          "skills",
          "agents",
          "instructions",
          "hooks",
          "resources",
          "codexMcpServers",
          "adapters",
        ),
      )
  )
    if (entry.plugin.source.type != "LOCAL_SOURCE")
      throw("Only local plugins are supported")
    else if (entry.plugin.source.path != "./plugins/" + entry.name)
      throw("Noncanonical plugin path")
    else if (entry.name != raw.name)
      throw("Plugin identity differs from marketplace")
    else if (entry.plugin.version != raw.version)
      throw("Plugin version differs from marketplace")
    else if (raw.type != "PLUGIN")
      throw("Expected a plugin manifest")
    else if (raw.schemaVersion != 1)
      throw("Unsupported plugin schema")
    else if (raw.getPropertyOrNull("adapters") != null)
      throw("Provider overrides are unsupported")
    else
      new Schema.Plugin {
        name = raw.name
        version = raw.version
        description = raw.description
        interface = (raw.getPropertyOrNull("interface") ?? new Dynamic {}).toTyped(Schema.Interface)
        tags = entry.getPropertyOrNull("tags")?.toList() ?? List()
        references = closure(raw).map((ref) -> asset(ref))
        hookFiles = closure(raw).flatMap((ref) -> support(ref)).distinct.sort()
        mcp =
          if (raw.getPropertyOrNull("codexMcpServers") == null)
            null
          else if (raw.codexMcpServers != "./.mcp.json")
            throw("Unsupported MCP path")
          else
            "source/plugins/" + raw.name + "/.mcp.json"
      }

local allPlugins = marketplace.plugins.toList().map((entry) -> plugin(entry))

function metadata(name: Schema.Identity): Dynamic =
  document("source/plugins/" + name + "/plugin.json").metadata

function registered(): List<Schema.Primitive> = definitions

function profile(raw: Dynamic): Schema.Profile =
  let (selected = raw.plugins.toList())
  let (found = allPlugins.filter((p) -> selected.contains(p.name)))
  let (
    selectedSkills =
      found
        .flatMap((p) ->
          p.references
            .filter((r) -> r.type == "SKILL")
            .map((r) -> r.name)
        )
        .toSet()
  )
  let (
    hooks =
      found.flatMap((p) ->
        p.references
          .filter((r) -> r.type == "HOOK")
          .map((r) -> r.name)
      )
  )
    if (selected.distinct.length != selected.length)
      throw("Duplicate profile plugin")
    else if (found.length != selected.length)
      throw("Unknown profile plugin")
    else if (hooks.distinct.length != hooks.length)
      throw("Profile selects a hook more than once")
    else
      new Schema.Profile {
        name = raw.name
        description = raw.description
        plugins = selected
        hookPolicy = raw.hookPolicy.mode
        focusSkills =
          (raw.getPropertyOrNull("focusSkills")?.toList())?.map((name) ->
            if (selectedSkills.contains(name)) name else throw("Unknown profile focus skill")
          )
        skills =
          (raw.getPropertyOrNull("skills")?.toMap() ?? Map()).map((id, binding) ->
            if (!id.startsWith("skill:"))
              throw("Invalid skill binding identity")
            else if (!selectedSkills.contains(id.drop(6)))
              throw("Unknown profile skill binding")
            else
              Pair(id, binding.toTyped(Schema.SkillBinding))
          )
      }

local fullInput: Schema.Input =
  if (marketplace.type != "MARKETPLACE")
    throw("Expected a marketplace")
  else if (marketplace.schemaVersion != 1)
    throw("Unsupported marketplace schema")
  else if (marketplace.getPropertyOrNull("adapters") != null)
    throw("Provider overrides are unsupported")
  else if (!(marketplace.getPropertyOrNull("externalMarketplaces")?.toList() ?? List()).isEmpty)
    throw("Remote marketplace resolution is unsupported")
  else if (definitions.map((ref) -> identity(ref)).distinct.length != definitions.length)
    throw("Duplicate marketplace primitive")
  else if (allPlugins.map((p) -> p.name).distinct.length != allPlugins.length)
    throw("Duplicate marketplace plugin")
  else
    new {
      name = marketplace.name
      owner = marketplace.owner.toTyped(Schema.Person)
      description = marketplace.description
      generatedAt = snapshot.generatedAt
      sourceSha = snapshot.sourceSha
      plugins = new Listing<Schema.Plugin> { for (p in allPlugins) { p } }
      profiles =
        documents.keys
          .toList()
          .filter((path) -> path.startsWith("source/profiles/") && path.endsWith(".json"))
          .sort()
          .map((path) -> profile(document(path)))
    }

input: Schema.Input =
  if (snapshot.getPropertyOrNull("profile") == null)
    fullInput
  else
    Pi.selectContent(fullInput, snapshot.profile)

output {
  value = input
  renderer = new JsonRenderer { omitNullProperties = true }
}
