module slopsentral.projection.Amp

import "Schema.pkl"

class Link {
  name: Schema.Identity
  path: Schema.RelativePath
}

class Catalog {
  name: Schema.Identity
  plugins: List<Link>
}

class Capabilities {
  schemaVersion: Int(this == 1) = 1
  skills: "REGISTERED" = "REGISTERED"
  instructions: "AGENT_START_CONTEXT" = "AGENT_START_CONTEXT"
  agents: "REFERENCE_ONLY" = "REFERENCE_ONLY"
  hooks: "REFERENCE_ONLY" = "REFERENCE_ONLY"
  mcp: "REFERENCE_ONLY" = "REFERENCE_ONLY"
  profiles: "UNSUPPORTED" = "UNSUPPORTED"
}

function literal(value: Any): String = (new JsonRenderer {}).renderValue(value)

local scriptInvocation: String =
  """
  Amp global plugins may lose bundled scripts' executable permissions. When a
  skill documents a direct script command, read its shebang and invoke that
  interpreter explicitly with the absolute script path and original arguments.
  Preserve interpreter flags: for `#!/usr/bin/env -S uv run --locked --script`,
  use `uv run --locked --script <script-path> ...`; for `#!/usr/bin/env python3`,
  use `python3 <script-path> ...`. Do not chmod or edit installed plugin caches.
  """

function entrypoint(plugin: Schema.Plugin): String =
  let (
    skills =
      plugin.references
        .filter((ref) -> ref.type == "SKILL")
        .sortBy((ref) -> ref.name)
  )
  let (
    instructions =
      plugin.references
        .filter((ref) -> ref.type == "INSTRUCTION")
        .sortBy((ref) -> ref.name)
  )
    """
    import { readFileSync } from 'node:fs';

    export const description = \(literal(plugin.description.take(300)));

    export default async function (amp) {
      // Read required context before registering anything; a missing payload fails loading.
      const instructions = \(literal(instructions.map((ref) -> "instructions/" + ref.name + "." + ref.sourcePath.split(".").last)))
        .map(path => readFileSync(new URL(path, import.meta.url), 'utf8').trim());
      instructions.unshift(\(literal(scriptInvocation)));
      for (const path of \(literal(skills.map((ref) -> "skills/" + ref.name)))) {
        await amp.registerSkill({ path });
      }
      amp.on('agent.start', () => ({ message: {
        content: instructions.join('\\n\\n'),
        display: false,
      } }));
    }
    """ + "\n"
