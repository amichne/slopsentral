{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "setup-pi.mts",
    "../source/hooks/pi/adapter.ts",
    "../source/hooks/pi/controls.ts"
  ]
}
