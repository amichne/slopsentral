{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.local/schemas/evals/routing-field-observations.schema.json",
  "title": "Routing Field Observation Set",
  "type": "object",
  "additionalProperties": false,
  "examples": [
    {
      "$schema": "../../schemas/evals/routing-field-observations.schema.json",
      "type": "ROUTING_FIELD_OBSERVATION_SET",
      "schemaVersion": 3,
      "name": "post-readiness-field-observations",
      "description": "Sanitized observations from real workflow execution after routing readiness work.",
      "observations": [
        {
          "type": "ROUTING_FIELD_OBSERVATION",
          "id": "pr-ci-remote-check-evidence-2026-06-22",
          "caseId": "ci-failure-triage-uses-remote-check-evidence",
          "capturedAt": "2026-06-22",
          "sourceType": "PR_VALIDATION",
          "outcome": "PASS",
          "evidenceRefs": [
            "PR 5 Validate Source run 27964536885 completed successfully."
          ],
          "productiveOutcomeObserved": {
            "type": "USEFUL_OUTCOME",
            "summary": "Remote check evidence was read after the branch changed."
          },
          "followUpAction": "Keep PR checks green after future pushes.",
          "limitations": [
            "This observation proves remote check handling, not Kotlin code execution."
          ],
          "route": {
            "type": "PRIMITIVE_ROUTE",
            "primitive": {
              "type": "SKILL",
              "name": "github-ci-operations"
            }
          },
          "activationEvidence": {
            "type": "REPORTED_ROUTE",
            "evidenceRefs": [
              "Existing summary reports the selected route; no raw skill-read trace was retained."
            ]
          },
          "verification": {
            "type": "COMPLETE_PROOF",
            "evidenceRefs": [
              "Relevant assertion executed and passed for the scoped claim."
            ]
          }
        }
      ]
    }
  ],
  "required": [
    "$schema",
    "type",
    "schemaVersion",
    "name",
    "description",
    "observations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "../../schemas/evals/routing-field-observations.schema.json"
      ],
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "enum": [
        "ROUTING_FIELD_OBSERVATION_SET"
      ],
      "examples": [
        "ROUTING_FIELD_OBSERVATION_SET"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        3
      ],
      "examples": [
        3
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "post-readiness-field-observations"
      ],
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "Sanitized observations from real workflow execution after routing readiness work."
      ],
      "pattern": "\\S"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "examples": [
        [
          {
            "type": "ROUTING_FIELD_OBSERVATION",
            "id": "pr-ci-remote-check-evidence-2026-06-22",
            "caseId": "ci-failure-triage-uses-remote-check-evidence",
            "capturedAt": "2026-06-22",
            "sourceType": "PR_VALIDATION",
            "outcome": "PASS",
            "evidenceRefs": [
              "PR 5 Validate Source run 27964536885 completed successfully."
            ],
            "productiveOutcomeObserved": {
              "type": "USEFUL_OUTCOME",
              "summary": "Remote check evidence was read after the branch changed."
            },
            "followUpAction": "Keep PR checks green after future pushes.",
            "limitations": [
              "This observation proves remote check handling, not Kotlin code execution."
            ],
            "route": {
              "type": "PRIMITIVE_ROUTE",
              "primitive": {
                "type": "SKILL",
                "name": "github-ci-operations"
              }
            },
            "activationEvidence": {
              "type": "REPORTED_ROUTE",
              "evidenceRefs": [
                "Existing summary reports the selected route; no raw skill-read trace was retained."
              ]
            },
            "verification": {
              "type": "COMPLETE_PROOF",
              "evidenceRefs": [
                "Relevant assertion executed and passed for the scoped claim."
              ]
            }
          }
        ]
      ],
      "items": {
        "$ref": "#/$defs/fieldObservation"
      }
    }
  },
  "$defs": {
    "fieldObservation": {
      "type": "object",
      "additionalProperties": false,
      "examples": [
        {
          "type": "ROUTING_FIELD_OBSERVATION",
          "id": "runtime-installed-state-visible-2026-06-22",
          "caseId": "plugin-install-recovery-proves-installed-state",
          "capturedAt": "2026-06-22",
          "sourceType": "RUNTIME_VERIFICATION",
          "outcome": "PASS",
          "evidenceRefs": [
            "codex plugin list reported kotlin-engineering@slopsentral installed and enabled."
          ],
          "productiveOutcomeObserved": {
            "type": "USEFUL_OUTCOME",
            "summary": "Provider-visible installed-state evidence was captured without editing installed caches."
          },
          "followUpAction": "Repeat the installed-state check in each target team environment.",
          "limitations": [
            "This does not prove the installed cache contains this branch head."
          ],
          "route": {
            "type": "PRIMITIVE_ROUTE",
            "primitive": {
              "type": "SKILL",
              "name": "repository-onboarding"
            }
          },
          "activationEvidence": {
            "type": "REPORTED_ROUTE",
            "evidenceRefs": [
              "Existing summary reports the selected route; no raw skill-read trace was retained."
            ]
          },
          "verification": {
            "type": "INCOMPLETE_PROOF",
            "missingEvidence": [
              "Exact cache source revision and fresh semantic invocation were not proved."
            ]
          }
        }
      ],
      "required": [
        "type",
        "id",
        "caseId",
        "capturedAt",
        "sourceType",
        "outcome",
        "route",
        "evidenceRefs",
        "productiveOutcomeObserved",
        "followUpAction",
        "limitations",
        "activationEvidence",
        "verification"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ROUTING_FIELD_OBSERVATION"
          ],
          "examples": [
            "ROUTING_FIELD_OBSERVATION"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "examples": [
            "runtime-installed-state-visible-2026-06-22"
          ]
        },
        "caseId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "examples": [
            "plugin-install-recovery-proves-installed-state"
          ]
        },
        "capturedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "examples": [
            "2026-06-22"
          ]
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "LIVE_SESSION",
            "PR_VALIDATION",
            "RUNTIME_VERIFICATION",
            "TEAM_FEEDBACK"
          ],
          "examples": [
            "RUNTIME_VERIFICATION"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "DRIFT",
            "BLOCKED",
            "NEEDS_REPLAY_CASE"
          ],
          "examples": [
            "PASS"
          ]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "productiveOutcomeObserved": {
          "$ref": "#/$defs/productiveOutcome"
        },
        "followUpAction": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Repeat the installed-state check in each target team environment."
          ],
          "pattern": "\\S"
        },
        "limitations": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "activationEvidence": {
          "$ref": "#/$defs/activationEvidence"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "examples": [
        {
          "type": "SKILL",
          "name": "repository-onboarding"
        }
      ],
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "AGENT",
            "HOOK",
            "PLUGIN",
            "PROFILE",
            "SKILL"
          ],
          "examples": [
            "SKILL"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "repository-onboarding"
          ],
          "pattern": "\\S"
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "examples": [
        [
          "codex plugin list reported kotlin-engineering@slopsentral installed and enabled."
        ]
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "examples": [
          "codex plugin list reported kotlin-engineering@slopsentral installed and enabled."
        ],
        "pattern": "\\S"
      }
    },
    "route": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "primitive"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "PRIMITIVE_ROUTE"
              ],
              "examples": [
                "PRIMITIVE_ROUTE"
              ]
            },
            "primitive": {
              "$ref": "#/$defs/primitive"
            }
          },
          "examples": [
            {
              "type": "PRIMITIVE_ROUTE",
              "primitive": {
                "type": "SKILL",
                "name": "tdd"
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "NO_PRIMITIVE_ROUTE"
              ],
              "examples": [
                "NO_PRIMITIVE_ROUTE"
              ]
            }
          },
          "examples": [
            {
              "type": "NO_PRIMITIVE_ROUTE"
            }
          ]
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "PRIMITIVE_ROUTE",
          "primitive": {
            "type": "SKILL",
            "name": "tdd"
          }
        },
        {
          "type": "NO_PRIMITIVE_ROUTE"
        }
      ]
    },
    "reportedRouteEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "evidenceRefs"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "REPORTED_ROUTE"
          ],
          "examples": [
            "REPORTED_ROUTE"
          ]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "examples": [
        {
          "type": "REPORTED_ROUTE",
          "evidenceRefs": [
            "Existing summary reports the selected route; no raw skill-read trace was retained."
          ]
        }
      ]
    },
    "toolTraceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionIds",
        "evidenceRefs"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TOOL_TRACE"
          ],
          "examples": [
            "TOOL_TRACE"
          ]
        },
        "sessionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "examples": [
              "01a0f01d-cff8-7c50-97eb-708bfae06a35"
            ]
          },
          "examples": [
            [
              "01a0f01d-cff8-7c50-97eb-708bfae06a35"
            ]
          ]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "examples": [
        {
          "type": "TOOL_TRACE",
          "sessionIds": [
            "01a0f01d-cff8-7c50-97eb-708bfae06a35"
          ],
          "evidenceRefs": [
            "Tool output returned tdd/SKILL.md frontmatter."
          ]
        }
      ]
    },
    "completeProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "evidenceRefs"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMPLETE_PROOF"
          ],
          "examples": [
            "COMPLETE_PROOF"
          ]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "examples": [
        {
          "type": "COMPLETE_PROOF",
          "evidenceRefs": [
            "Relevant assertion executed and passed for the scoped claim."
          ]
        }
      ]
    },
    "incompleteProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "missingEvidence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "INCOMPLETE_PROOF"
          ],
          "examples": [
            "INCOMPLETE_PROOF"
          ]
        },
        "missingEvidence": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "examples": [
        {
          "type": "INCOMPLETE_PROOF",
          "missingEvidence": [
            "Fresh client discovery and semantic invocation remain unverified."
          ]
        }
      ]
    },
    "unassessedProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "UNASSESSED_PROOF"
          ],
          "examples": [
            "UNASSESSED_PROOF"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "examples": [
            "A useful answer was observed; independent outcome verification was not retained."
          ],
          "pattern": "\\S"
        }
      },
      "examples": [
        {
          "type": "UNASSESSED_PROOF",
          "reason": "A useful answer was observed; independent outcome verification was not retained."
        }
      ]
    },
    "activationEvidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/reportedRouteEvidence"
        },
        {
          "$ref": "#/$defs/toolTraceEvidence"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "REPORTED_ROUTE",
          "evidenceRefs": [
            "Existing summary reports the selected route; no raw skill-read trace was retained."
          ]
        },
        {
          "type": "TOOL_TRACE",
          "sessionIds": [
            "01a0f01d-cff8-7c50-97eb-708bfae06a35"
          ],
          "evidenceRefs": [
            "Tool output returned tdd/SKILL.md frontmatter."
          ]
        }
      ]
    },
    "verification": {
      "oneOf": [
        {
          "$ref": "#/$defs/completeProof"
        },
        {
          "$ref": "#/$defs/incompleteProof"
        },
        {
          "$ref": "#/$defs/unassessedProof"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "COMPLETE_PROOF",
          "evidenceRefs": [
            "Relevant assertion executed and passed for the scoped claim."
          ]
        },
        {
          "type": "INCOMPLETE_PROOF",
          "missingEvidence": [
            "Fresh client discovery and semantic invocation remain unverified."
          ]
        },
        {
          "type": "UNASSESSED_PROOF",
          "reason": "A useful answer was observed; independent outcome verification was not retained."
        }
      ]
    },
    "usefulOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summary"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "USEFUL_OUTCOME"
          ],
          "examples": [
            "USEFUL_OUTCOME"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "examples": [
            "The requested result was produced within the scoped claim."
          ],
          "pattern": "\\S"
        }
      },
      "examples": [
        {
          "type": "USEFUL_OUTCOME",
          "summary": "The requested result was produced within the scoped claim."
        }
      ]
    },
    "noUsefulOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NO_USEFUL_OUTCOME"
          ],
          "examples": [
            "NO_USEFUL_OUTCOME"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "examples": [
            "The expected skill loaded but the requested result was not produced."
          ],
          "pattern": "\\S"
        }
      },
      "examples": [
        {
          "type": "NO_USEFUL_OUTCOME",
          "reason": "The expected skill loaded but the requested result was not produced."
        }
      ]
    },
    "unassessedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "UNASSESSED_OUTCOME"
          ],
          "examples": [
            "UNASSESSED_OUTCOME"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "examples": [
            "No task outcome evidence was retained."
          ],
          "pattern": "\\S"
        }
      },
      "examples": [
        {
          "type": "UNASSESSED_OUTCOME",
          "reason": "No task outcome evidence was retained."
        }
      ]
    },
    "productiveOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/usefulOutcome"
        },
        {
          "$ref": "#/$defs/noUsefulOutcome"
        },
        {
          "$ref": "#/$defs/unassessedOutcome"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "USEFUL_OUTCOME",
          "summary": "The requested result was produced within the scoped claim."
        },
        {
          "type": "NO_USEFUL_OUTCOME",
          "reason": "The expected skill loaded but the requested result was not produced."
        },
        {
          "type": "UNASSESSED_OUTCOME",
          "reason": "No task outcome evidence was retained."
        }
      ]
    }
  }
}
