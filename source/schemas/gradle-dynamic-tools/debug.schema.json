{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/gradle-dynamic-tools/debug.schema.json",
  "title": "DEBUG",
  "description": "Attaches to and controls the JDI session for one debug-enabled Gradle test run.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "DEBUG"
      ],
      "examples": [
        "DEBUG"
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "examples": [
        "12345678-1234-4234-8234-123456789abc"
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ATTACH"
              ],
              "examples": [
                "ATTACH"
              ]
            },
            "timeoutMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000,
              "examples": [
                5000
              ]
            }
          },
          "required": [
            "type",
            "timeoutMillis"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "ATTACH",
              "timeoutMillis": 5000
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "THREADS"
              ],
              "examples": [
                "THREADS"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "THREADS"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "STACK"
              ],
              "examples": [
                "STACK"
              ]
            },
            "threadId": {
              "type": "integer",
              "minimum": 1,
              "examples": [
                1
              ]
            },
            "maximumFrames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128,
              "examples": [
                32
              ]
            }
          },
          "required": [
            "type",
            "threadId",
            "maximumFrames"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "STACK",
              "threadId": 1,
              "maximumFrames": 32
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "PAUSE"
              ],
              "examples": [
                "PAUSE"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "PAUSE"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RESUME"
              ],
              "examples": [
                "RESUME"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "RESUME"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "DETACH"
              ],
              "examples": [
                "DETACH"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "DETACH"
            }
          ]
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "ATTACH",
          "timeoutMillis": 5000
        }
      ]
    }
  },
  "required": [
    "type",
    "runId",
    "operation"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "DEBUG",
      "runId": "12345678-1234-4234-8234-123456789abc",
      "operation": {
        "type": "ATTACH",
        "timeoutMillis": 5000
      }
    }
  ]
}
