{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/gradle-dynamic-tools/gradle-dynamic-tools.schema.json",
  "title": "GRADLE_DYNAMIC_TOOLS",
  "description": "Closed catalog of repository-scoped Gradle dynamic tool requests.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "GRADLE_DYNAMIC_TOOLS"
      ],
      "examples": [
        "GRADLE_DYNAMIC_TOOLS"
      ]
    },
    "gradleDynamicTools": {
      "oneOf": [
        {
          "$ref": "start.schema.json"
        },
        {
          "$ref": "observe.schema.json"
        },
        {
          "$ref": "cancel.schema.json"
        },
        {
          "$ref": "discover.schema.json"
        },
        {
          "$ref": "history.schema.json"
        },
        {
          "$ref": "debug.schema.json"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "START",
          "operation": {
            "type": "TASKS",
            "tasks": [
              ":app:test"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "type",
    "gradleDynamicTools"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "GRADLE_DYNAMIC_TOOLS",
      "gradleDynamicTools": {
        "type": "START",
        "operation": {
          "type": "TASKS",
          "tasks": [
            ":app:test"
          ]
        }
      }
    }
  ]
}
