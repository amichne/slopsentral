{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/gradle-dynamic-tools/discover.schema.json",
  "title": "DISCOVER",
  "description": "Discovers bounded task metadata from the repository Gradle project model.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "DISCOVER"
      ],
      "examples": [
        "DISCOVER"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\r\\n]+$",
      "examples": [
        "test"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "examples": [
        100
      ]
    }
  },
  "required": [
    "type",
    "limit"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "DISCOVER",
      "query": "test",
      "limit": 100
    }
  ]
}
