{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/gradle-dynamic-tools/cancel.schema.json",
  "title": "CANCEL",
  "description": "Idempotently requests cancellation of one known Gradle run.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "CANCEL"
      ],
      "examples": [
        "CANCEL"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "examples": [
        "00000000-0000-4000-8000-000000000001"
      ]
    }
  },
  "required": [
    "type",
    "runId"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "CANCEL",
      "runId": "00000000-0000-4000-8000-000000000001"
    }
  ]
}
