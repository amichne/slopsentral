{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/gradle-dynamic-tools/observe.schema.json",
  "title": "OBSERVE",
  "description": "Returns run state and output events strictly after a cursor, optionally waiting for change.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "OBSERVE"
      ],
      "examples": [
        "OBSERVE"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "examples": [
        "00000000-0000-4000-8000-000000000001"
      ]
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "examples": [
        0
      ]
    },
    "waitMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000,
      "examples": [
        1000
      ]
    }
  },
  "required": [
    "type",
    "runId",
    "after",
    "waitMillis"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "OBSERVE",
      "runId": "00000000-0000-4000-8000-000000000001",
      "after": 0,
      "waitMillis": 1000
    }
  ]
}
