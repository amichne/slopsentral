{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/gradle-dynamic-tools/history.schema.json",
  "title": "HISTORY",
  "description": "Lists or reads repository-persistent Gradle run summaries.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "HISTORY"
      ],
      "examples": [
        "HISTORY"
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "LIST"
              ],
              "examples": [
                "LIST"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "examples": [
                20
              ]
            }
          },
          "required": [
            "type",
            "limit"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "LIST",
              "limit": 20
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "READ"
              ],
              "examples": [
                "READ"
              ]
            },
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "examples": [
                "12345678-1234-4234-8234-123456789abc"
              ]
            }
          },
          "required": [
            "type",
            "runId"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "type": "READ",
              "runId": "12345678-1234-4234-8234-123456789abc"
            }
          ]
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "LIST",
          "limit": 20
        }
      ]
    }
  },
  "required": [
    "type",
    "operation"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "HISTORY",
      "operation": {
        "type": "LIST",
        "limit": 20
      }
    }
  ]
}
