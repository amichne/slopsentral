              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "examples": [
                "local-rules"
              ]
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(instruction|skill|resource|agent|hook):[a-z][a-z0-9-]*$",
                "examples": [
                  "instruction:local-rules"
                ]
              },
              "uniqueItems": true,
              "examples": [
                []
              ]
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "string",
