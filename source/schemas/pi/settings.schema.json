{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/pi/settings.schema.json",
  "title": "Pi capability settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ],
      "examples": [
        1
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "examples": [
        "local-rules"
      ]
    },
    "enabled": {
      "type": "boolean",
      "examples": [true]
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^skill:[a-z][a-z0-9-]*$",
        "examples": ["skill:semantic-ratchet"]
      },
      "additionalProperties": {"$ref": "#/$defs/skillBinding"},
      "description": "This intentional map uses skill identities and typed invocation policies.",
      "examples": [{"skill:semantic-ratchet": {"invocation": "either"}}]
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(instruction|skill|resource|agent|hook):[a-z][a-z0-9-]*$",
        "examples": [
          "instruction:local-rules"
        ]
      },
      "additionalProperties": {
        "type": "boolean",
        "examples": [
          true
        ]
      },
      "examples": [
        {
          "instruction:local-rules": true
        }
      ],
      "description": "This intentional map uses constrained identity keys and typed values."
    },
    "hooks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^hook:[a-z][a-z0-9-]*$",
        "examples": [
          "hook:local-gate"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/policy"
      },
      "examples": [
        {}
      ],
      "description": "This intentional map uses constrained identity keys and typed values."
    },
    "additions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "examples": [
        []
      ]
    },
    "mutationAdapters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "examples": [
          "custom_write"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "examples": [
            "path"
          ]
        },
        "minItems": 1,
        "examples": [
          [
            "path"
          ]
        ]
      },
      "examples": [
        {
          "custom_write": [
            "path"
          ]
        }
      ],
      "description": "This intentional map uses constrained identity keys and typed values."
    }
  },
  "required": [
    "schemaVersion"
  ],
  "examples": [
    {
      "schemaVersion": 1,
      "profile": "local-development-default"
    }
  ],
  "$defs": {
    "skillBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation"],
      "properties": {
        "invocation": {
          "type": "string",
          "enum": ["human", "model", "either"],
          "examples": ["either"]
        }
      },
      "examples": [{"invocation": "either"}]
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ALWAYS"
              ],
              "examples": [
                "ALWAYS"
              ]
            }
          },
          "required": [
            "type"
          ],
          "examples": [
            {
              "type": "ALWAYS"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ERRORS"
              ],
              "examples": [
                "ERRORS"
              ]
            }
          },
          "required": [
            "type"
          ],
          "examples": [
            {
              "type": "ERRORS"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "NEVER"
              ],
              "examples": [
                "NEVER"
              ]
            }
          },
          "required": [
            "type"
          ],
          "examples": [
            {
              "type": "NEVER"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "EXCLUDE"
              ],
              "examples": [
                "EXCLUDE"
              ]
            },
            "pattern": {
              "type": "string",
              "maxLength": 1024,
              "format": "regex",
              "examples": [
                "^NOTICE:"
              ]
            }
          },
          "required": [
            "type",
            "pattern"
          ],
          "examples": [
            {
              "type": "EXCLUDE",
              "pattern": "^NOTICE:"
            }
          ]
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "ALWAYS"
        },
        {
          "type": "EXCLUDE",
          "pattern": "^NOTICE:"
        }
      ],
      "type": "object"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution": {
          "type": "string",
          "enum": [
            "foreground",
            "background"
          ],
          "examples": [
            "foreground"
          ]
        },
        "critical": {
          "type": "string",
          "enum": [
            "report",
            "blocking"
          ],
          "examples": [
            "report"
          ]
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "context": {
          "type": "string",
          "enum": [
            "structured",
            "none"
          ],
          "examples": [
            "structured"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "examples": [
            30
          ]
        }
      },
      "required": [
        "execution",
        "critical",
        "output",
        "context"
      ],
      "examples": [
        {
          "execution": "background",
          "critical": "report",
          "output": {
            "type": "ERRORS"
          },
          "context": "none"
        }
      ],
      "if": {
        "properties": {
          "execution": {
            "enum": [
              "background"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "critical": {
            "enum": [
              "report"
            ]
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "examples": [
            "local-rules"
          ]
        },
        "event": {
          "type": "string",
          "enum": [
            "SessionStart",
            "UserPromptSubmit",
            "PreToolUse",
            "PostToolUse",
            "Stop"
          ],
          "examples": [
            "SessionStart"
          ]
        },
        "plugin": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "examples": [
            "local-rules"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$",
            "examples": [
              "/work/rules.md"
            ]
          },
          "minItems": 1,
          "examples": [
            [
              "/usr/bin/true"
            ]
          ]
        },
        "matcher": {
          "type": "string",
          "maxLength": 1024,
          "examples": [
            "^write$"
          ],
          "description": "An asterisk selects every subject. Other values use JavaScript regex syntax."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "examples": [
            30
          ]
        }
      },
      "required": [
        "name",
        "event",
        "plugin",
        "argv",
        "timeout"
      ],
      "examples": [
        {
          "name": "local-gate",
          "event": "Stop",
          "plugin": "local",
          "argv": [
            "/usr/bin/true"
          ],
          "timeout": 30
        }
      ]
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^instruction:[a-z][a-z0-9-]*$",
              "examples": [
