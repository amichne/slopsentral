{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/pi/scope-assessment.schema.json",
  "title": "Explicit Pi scope assessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hook_event_name": {
      "type": "string",
      "enum": [
        "Stop"
      ],
      "examples": [
        "Stop"
      ]
    },
    "cwd": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$",
      "examples": [
        "/work/repository"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "examples": [
        "session-a"
      ]
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\.$)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[^\\u0000]+$",
        "examples": [
          "module/main.py"
        ]
      },
      "examples": [
        [
          "module/main.py",
          "AGENTS.md"
        ]
      ]
    },
    "stop_hook_active": {
      "type": "boolean",
      "examples": [
        false
      ]
    }
  },
  "required": [
    "hook_event_name",
    "cwd",
    "session_id",
    "changed_paths"
  ],
  "examples": [
    {
      "hook_event_name": "Stop",
      "cwd": "/work/repository",
      "session_id": "session-a",
      "changed_paths": [
        "module/main.py"
      ]
    }
  ]
}
