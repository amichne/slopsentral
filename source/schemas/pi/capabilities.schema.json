{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/pi/capabilities.schema.json",
  "title": "Pi capability catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ],
      "examples": [
        1
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "settings.schema.json#/$defs/capability"
      },
      "examples": [
        []
      ]
    }
  },
  "required": [
    "schemaVersion",
    "capabilities"
  ],
  "examples": [
    {
      "schemaVersion": 1,
      "capabilities": []
    }
  ]
}
