{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/pi/setup.schema.json",
  "title": "Native Pi setup receipt",
  "description": "The tested consumer installer bound to a qualified native Pi candidate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ],
      "examples": [
        1
      ]
    },
    "repository": {
      "type": "string",
      "enum": [
        "amichne/slopsentral"
      ],
      "examples": [
        "amichne/slopsentral"
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
      "examples": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.[1-9][0-9]*$",
      "examples": [
        "0.1.123"
      ]
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "examples": [
        "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "enum": [
              "install-pi.sh",
              "setup-pi.mts"
            ],
            "examples": [
              "setup-pi.mts"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "examples": [
              "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152,
            "examples": [
              1024
            ]
          }
        },
        "required": [
          "file",
          "sha256",
          "size"
        ],
        "examples": [
          {
            "file": "setup-pi.mts",
            "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "size": 1024
          }
        ]
      },
      "examples": [
        [
          {
            "file": "setup-pi.mts",
            "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "size": 1024
          },
          {
            "file": "install-pi.sh",
            "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "size": 1024
          }
        ]
      ]
    }
  },
  "required": [
    "schema_version",
    "repository",
    "source_revision",
    "version",
    "candidate_sha256",
    "files"
  ],
  "examples": [
    {
      "schema_version": 1,
      "repository": "amichne/slopsentral",
      "source_revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "version": "0.1.123",
      "candidate_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "files": [
        {
          "file": "setup-pi.mts",
          "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
          "size": 1024
        },
        {
          "file": "install-pi.sh",
          "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
          "size": 1024
        }
      ]
    }
  ]
}
