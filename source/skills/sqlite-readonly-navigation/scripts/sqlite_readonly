#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    "Usage: sqlite_readonly (--database PATH [--workspace DIR] | --kast-workspace DIR) [--json] [--query SQL] [--print-path] [--timeout-ms N]"
}

die() {
  printf 'sqlite_readonly: %s\n' "$*" >&2
  exit 2
}

canonical_file() {
  local executable_path="$1"
  local executable_dir
  local link_target
  local symlink_hops=0

  while [[ -L "$executable_path" ]]; do
    ((symlink_hops += 1))
    ((symlink_hops <= 40)) || return 1
    executable_dir="$(cd "$(dirname "$executable_path")" && pwd -P)"
    link_target="$(readlink "$executable_path")"
    if [[ "$link_target" == /* ]]; then
      executable_path="$link_target"
    else
      executable_path="$executable_dir/$link_target"
    fi
  done
  [[ -f "$executable_path" ]] || return 1
  executable_dir="$(cd "$(dirname "$executable_path")" && pwd -P)"
  printf '%s/%s\n' "$executable_dir" "$(basename "$executable_path")"
}

DATABASE=""
WORKSPACE=""
KAST_WORKSPACE=""
QUERY=""
JSON_OUTPUT=false
PRINT_PATH=false
TIMEOUT_MS=5000

while (($#)); do
  case "$1" in
    --database)
      (($# >= 2)) || die "--database requires a path"
      DATABASE="$2"
      shift 2
      ;;
    --workspace)
      (($# >= 2)) || die "--workspace requires a directory"
      WORKSPACE="$2"
      shift 2
      ;;
    --kast-workspace)
      (($# >= 2)) || die "--kast-workspace requires a directory"
      KAST_WORKSPACE="$2"
      shift 2
      ;;
    --query)
      (($# >= 2)) || die "--query requires SQL"
      QUERY="$2"
      shift 2
      ;;
    --timeout-ms)
      (($# >= 2)) || die "--timeout-ms requires an integer"
      TIMEOUT_MS="$2"
      shift 2
      ;;
    --json)
      JSON_OUTPUT=true
      shift
      ;;
    --print-path)
      PRINT_PATH=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if ! [[ "$TIMEOUT_MS" =~ ^[0-9]+$ ]] || ((TIMEOUT_MS <= 0)); then
  die "--timeout-ms must be a positive integer"
fi
if $PRINT_PATH && [[ -n "$QUERY" || "$JSON_OUTPUT" == true ]]; then
  die "--print-path cannot be combined with --query or --json"
fi

if [[ -n "$KAST_WORKSPACE" ]]; then
  command -v jq >/dev/null 2>&1 || die "jq is required for --kast-workspace"
  command -v rg >/dev/null 2>&1 || die "rg is required for --kast-workspace"
  [[ -z "$DATABASE" && -z "$WORKSPACE" ]] ||
    die "--kast-workspace cannot be combined with --database or --workspace"
  [[ -d "$KAST_WORKSPACE" ]] ||
    die "Kast workspace does not exist: $KAST_WORKSPACE"
  KAST_WORKSPACE="$(cd "$KAST_WORKSPACE" && pwd -P)"

  PUBLIC_BIN="${KAST_PUBLIC_BIN:-$(command -v kast || true)}"
  [[ -n "$PUBLIC_BIN" ]] || die "Kast public binary is unavailable"
  PUBLIC_BIN="$(canonical_file "$PUBLIC_BIN")" ||
    die "cannot resolve Kast public binary: $PUBLIC_BIN"
  RELEASE_ROOT="$(cd "$(dirname "$PUBLIC_BIN")/.." && pwd -P)"
  RECEIPT="$RELEASE_ROOT/receipt.json"
  [[ -f "$RECEIPT" ]] || die "Kast release receipt does not exist: $RECEIPT"
  DATA_ROOT="$(
    jq -er '
      select(.tool == "kast")
      | .roots.data
      | select(type == "string" and length > 0)
    ' "$RECEIPT"
  )" || die "Kast receipt has no data root"
  [[ -d "$DATA_ROOT/workspaces" ]] ||
    die "Kast receipt has no existing workspace metadata root"
  DATA_ROOT="$(cd "$DATA_ROOT" && pwd -P)"

  DATABASE_MATCHES=()
  while IFS= read -r WORKSPACE_METADATA; do
    METADATA_ROOT="$(jq -er '.workspaceRoot' "$WORKSPACE_METADATA" 2>/dev/null)" ||
      continue
    [[ -d "$METADATA_ROOT" ]] || continue
    METADATA_ROOT="$(cd "$METADATA_ROOT" && pwd -P)"
    [[ "$METADATA_ROOT" == "$KAST_WORKSPACE" ]] || continue
    DATABASE_CANDIDATE="$(dirname "$WORKSPACE_METADATA")/cache/source-index.db"
    [[ -f "$DATABASE_CANDIDATE" ]] || continue
    DATABASE_MATCHES+=("$DATABASE_CANDIDATE")
  done < <(rg --files "$DATA_ROOT/workspaces" -g 'workspace.json')

  case "${#DATABASE_MATCHES[@]}" in
    1) DATABASE="${DATABASE_MATCHES[0]}" ;;
    0)
      die "no existing Kast database metadata matches $KAST_WORKSPACE; pass --database"
      ;;
    *)
      die "multiple Kast databases match $KAST_WORKSPACE; pass --database"
      ;;
  esac
else
  [[ -n "$DATABASE" ]] || die "--database or --kast-workspace is required"
  if [[ "$DATABASE" != /* ]]; then
    [[ -n "$WORKSPACE" ]] ||
      die "relative --database requires --workspace"
    [[ -d "$WORKSPACE" ]] || die "workspace does not exist: $WORKSPACE"
    WORKSPACE="$(cd "$WORKSPACE" && pwd -P)"
    DATABASE="$WORKSPACE/$DATABASE"
  elif [[ -n "$WORKSPACE" ]]; then
    die "--workspace is only valid with a relative --database"
  fi
fi

[[ -f "$DATABASE" ]] || die "database does not exist: $DATABASE"
DATABASE="$(canonical_file "$DATABASE")" ||
  die "cannot resolve database: $DATABASE"

if $PRINT_PATH; then
  printf '%s\n' "$DATABASE"
  exit 0
fi

SQLITE_BIN="${SQLITE_BIN:-$(command -v sqlite3 || true)}"
[[ -n "$SQLITE_BIN" && -x "$SQLITE_BIN" ]] ||
  die "sqlite3 is required"
SQLITE_VERSION="$("$SQLITE_BIN" --version | awk 'NR == 1 { print $1 }')"
if ! [[ "$SQLITE_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
  die "cannot parse sqlite3 version: $SQLITE_VERSION"
fi
SQLITE_MAJOR="${BASH_REMATCH[1]}"
SQLITE_MINOR="${BASH_REMATCH[2]}"
SQLITE_PATCH="${BASH_REMATCH[3]}"
if ((
  SQLITE_MAJOR < 3 ||
  (SQLITE_MAJOR == 3 && SQLITE_MINOR < 40) ||
  (SQLITE_MAJOR == 3 && SQLITE_MINOR == 40 && SQLITE_PATCH < 1)
)); then
  die "sqlite3 3.40.1 or newer is required for safe mode"
fi
SQLITE_HELP="$("$SQLITE_BIN" --help 2>&1 || true)"
if [[ "$SQLITE_HELP" != *"-safe"* || "$SQLITE_HELP" != *"-nofollow"* ]]; then
  die "sqlite3 must support -safe and -nofollow"
fi

SQLITE_ARGS=(
  -safe
  -nofollow
  -readonly
  -bail
  -cmd ".timeout $TIMEOUT_MS"
  -cmd "PRAGMA query_only=ON;"
  -cmd "PRAGMA trusted_schema=OFF;"
)
$JSON_OUTPUT && SQLITE_ARGS+=(-json)

if [[ -n "$QUERY" ]]; then
  exec "$SQLITE_BIN" "${SQLITE_ARGS[@]}" "$DATABASE" "$QUERY"
else
  exec "$SQLITE_BIN" "${SQLITE_ARGS[@]}" "$DATABASE"
fi
