{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/knowledge-overlay.py",
            "timeout": 20,
            "additionalContextLimit": 8192,
            "statusMessage": "Loading registered repository knowledge guidance"
          }
        ]
      }
    ]
  }
}
