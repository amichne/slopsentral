{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --script hooks/inject-instruction-context.py --instruction agent-execution --instruction engineering-design",
            "timeout": 10,
            "additionalContextLimit": 8192,
            "statusMessage": "Loading software-engineering policy"
          }
        ]
      }
    ]
  }
}
