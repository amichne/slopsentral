{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/inject-concept-context.py --concept kotlin-repository-engineering",
            "timeout": 10,
            "statusMessage": "Loading Kotlin repository context",
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
