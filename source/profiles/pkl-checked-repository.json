{
  "type": "WORKFLOW_PROFILE",
  "schemaVersion": 2,
  "name": "pkl-checked-repository",
  "description": "Legacy profile identifier for Pkl guidance. Automatic Pkl checks need an explicit custom hook composition.",
  "marketplaces": [
    {
      "type": "WORKFLOW_MARKETPLACE",
      "name": "slopsentral",
      "provider": "codex",
      "source": "https://github.com/amichne/slopsentral/tree/harness/codex",
      "entrypoint": ".agents/plugins/marketplace.json",
      "scope": "plugins in this workflow profile"
    }
  ],
  "plugins": [
    "software-engineering",
    "developer-tooling"
  ],
  "standaloneSkills": [],
  "hookPolicy": {
    "type": "HOOK_POLICY",
    "mode": "ADVISORY"
  },
  "reconciliation": {
    "type": "PLUGIN_RECONCILIATION",
    "unselected": "DISABLE_UNSELECTED"
  },
  "validation": {
    "type": "WORKFLOW_VALIDATION",
    "commands": [
      "node tools/validate-source-graph.mjs",
      "uv run --locked tools/marketplace.py project --source . --harness codex --out /tmp/slopsentral-codex",
      "uv run --locked tools/marketplace.py project --source . --harness github-copilot --out /tmp/slopsentral-github-copilot"
    ]
  }
}
