{
  "type": "WORKFLOW_PROFILE",
  "schemaVersion": 2,
  "name": "kotlin-repo-default",
  "description": "Kotlin repository workflow with engineering guidance, source-backed knowledge and navigation, local developer tools, and delivery. Automatically selected by a repository-root settings.gradle.kts.",
  "marketplaces": [
    {
      "type": "WORKFLOW_MARKETPLACE",
      "name": "slopsentral",
      "provider": "codex",
      "source": "https://github.com/amichne/slopsentral/tree/harness/codex",
      "entrypoint": ".agents/plugins/marketplace.json",
      "scope": "plugins in this workflow profile"
    }
  ],
  "plugins": [
    "engineering-baseline",
    "kotlin-engineering",
    "developer-tools",
    "effective-delivery",
    "code-knowledge-base"
  ],
  "standaloneSkills": [],
  "hookPolicy": {
    "type": "HOOK_POLICY",
    "mode": "ADVISORY"
  },
  "reconciliation": {
    "type": "PLUGIN_RECONCILIATION",
    "unselected": "DISABLE_UNSELECTED"
  },
  "validation": {
    "type": "WORKFLOW_VALIDATION",
    "commands": [
      "node tools/validate-source-graph.mjs",
      "projeKtor project --source . --harness codex --out /tmp/slopsentral-codex",
      "projeKtor project --source . --harness github-copilot --out /tmp/slopsentral-github-copilot"
    ]
  },
  "activation": {
    "type": "REPOSITORY_ROOT_FILE",
    "path": "settings.gradle.kts"
  }
}
