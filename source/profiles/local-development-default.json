{
  "type": "WORKFLOW_PROFILE",
  "schemaVersion": 2,
  "name": "local-development-default",
  "description": "Everyday implementation, testing, Git, and delivery capabilities. Local tasks stay local unless publication is requested.",
  "marketplaces": [
    {
      "type": "WORKFLOW_MARKETPLACE",
      "name": "slopsentral",
      "provider": "codex",
      "source": "https://github.com/amichne/slopsentral/tree/harness/codex",
      "entrypoint": ".agents/plugins/marketplace.json",
      "scope": "plugins in this workflow profile"
    }
  ],
  "plugins": [
    "software-engineering"
  ],
  "standaloneSkills": [],
  "skills": {
    "skill:git-change-flow": { "invocation": "either" },
    "skill:github-ci-operations": { "invocation": "either" },
    "skill:issue-tracker-operations": { "invocation": "either" },
    "skill:mise-project-tooling": { "invocation": "either" },
    "skill:pull-request-lifecycle": { "invocation": "either" },
    "skill:python-tooling": { "invocation": "either" },
    "skill:semantic-ratchet": { "invocation": "either" },
    "skill:tdd": { "invocation": "either" }
  },
  "hookPolicy": {
    "type": "HOOK_POLICY",
    "mode": "ADVISORY"
  },
  "reconciliation": {
    "type": "PLUGIN_RECONCILIATION",
    "unselected": "DISABLE_UNSELECTED"
  },
  "validation": {
    "type": "WORKFLOW_VALIDATION",
    "commands": [
      "node tools/validate-source-graph.mjs",
      "node tools/project-marketplaces.mjs --source . --harness codex --out /tmp/slopsentral-codex",
      "node tools/project-marketplaces.mjs --source . --harness github-copilot --out /tmp/slopsentral-github-copilot"
    ]
  }
}
