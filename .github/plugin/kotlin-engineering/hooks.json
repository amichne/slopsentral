{
  "hooks": {
    "SessionStart": [
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/inject-instruction-context.py\" --instruction kotlin-engineering",
        "matcher": "^(startup|resume|clear|compact)$",
        "timeoutSec": 10,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/codex-stop.py\" -- uv run --locked --script \"$PLUGIN_ROOT/hooks/gradle-check-green.py\" --repo .",
        "timeoutSec": 1800,
        "type": "command"
      },
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/codex-stop.py\" -- uv run --locked --script \"$PLUGIN_ROOT/hooks/gradle-wrapper-integrity.py\" --repo .",
        "timeoutSec": 30,
        "type": "command"
      },
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/codex-stop.py\" --advisory -- uv run --locked --script \"$PLUGIN_ROOT/hooks/kotlin-horizontalization-check\" --repo . --summary",
        "timeoutSec": 30,
        "type": "command"
      }
    ]
  },
  "version": 1
}
