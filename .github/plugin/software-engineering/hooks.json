{
  "hooks": {
    "PostToolUse": [
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/agents-md-scope.py\"",
        "timeoutSec": 30,
        "type": "command"
      }
    ],
    "SessionStart": [
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/inject-instruction-context.py\" --instruction agent-execution --instruction engineering-design",
        "matcher": "^(startup|resume|clear|compact)$",
        "timeoutSec": 10,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/agents-md-scope.py\"",
        "timeoutSec": 30,
        "type": "command"
      }
    ],
    "UserPromptSubmit": [
      {
        "bash": "uv run --locked --script \"$PLUGIN_ROOT/hooks/agents-md-scope.py\"",
        "timeoutSec": 30,
        "type": "command"
      }
    ]
  },
  "version": 1
}
