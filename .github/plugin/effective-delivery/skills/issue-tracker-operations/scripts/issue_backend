#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from typing import Mapping, Sequence, cast

from issue_backend_config import resolve_backend, resolve_github_repository
from issue_backend_output import emit
from issue_backend_providers import CommandRunner, GitHubProvider, IssueProvider, JiraProvider
from issue_backend_types import (
    Backend,
    IssueBackendError,
    Operation,
    capabilities,
    failure_envelope,
    success_envelope,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="issue_backend",
        description="Read issue data through the configured Effective Delivery backend.",
    )
    parser.add_argument(
        "--backend",
        choices=("github", "jira"),
        help="Override EFFECTIVE_DELIVERY_ISSUE_BACKEND for this invocation.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    capabilities_parser = subparsers.add_parser(
        "capabilities",
        help="Report exact backend capability support without provider I/O.",
    )
    capabilities_parser.add_argument("--json", action="store_true", help="Emit canonical JSON instead of TOON.")

    view_parser = subparsers.add_parser("view", help="Read one issue or Jira work item.")
    view_parser.add_argument("identifier", help="GitHub issue number or Jira work item key.")
    view_parser.add_argument("--json", action="store_true", help="Emit canonical JSON instead of TOON.")

    dependency_parser = subparsers.add_parser(
        "dependency-map",
        help="Read the direct blocker map for one issue.",
    )
    dependency_parser.add_argument("identifier", help="GitHub issue number or Jira work item key.")
    dependency_parser.add_argument("--json", action="store_true", help="Emit canonical JSON instead of TOON.")
    return parser


def _operation(command: str) -> Operation:
    return {
        "capabilities": Operation.CAPABILITIES,
        "view": Operation.VIEW,
        "dependency-map": Operation.DEPENDENCY_MAP,
    }[command]


def _provider(
    backend: Backend,
    environment: Mapping[str, str],
) -> IssueProvider:
    runner = CommandRunner(environment)
    if backend is Backend.JIRA:
        return JiraProvider(runner)
    return GitHubProvider(runner, resolve_github_repository(environment))


def run(
    arguments: Sequence[str] | None = None,
    environment: Mapping[str, str] = os.environ,
) -> int:
    parser = build_parser()
    parsed = parser.parse_args(arguments)
    json_output = bool(parsed.json)
    backend: Backend | None = None
    operation = _operation(parsed.command)

    try:
        backend = resolve_backend(parsed.backend, environment)
        result = success_envelope(backend, operation)
        payload = cast(dict[str, object], result["result"])
        if operation is Operation.CAPABILITIES:
            payload["capabilities"] = [state.to_dict() for state in capabilities()]
            payload["evidence"] = []
        else:
            provider = _provider(backend, environment)
            if operation is Operation.VIEW:
                observation = provider.view(parsed.identifier)
                payload["issue"] = observation.value.to_issue_dict()
            else:
                observation = provider.dependency_map(parsed.identifier)
                payload["dependencyMap"] = observation.value.to_dict()
            payload["evidence"] = [item.to_dict() for item in observation.evidence]
        emit(result, json_output)
        return 0
    except IssueBackendError as error:
        emit(failure_envelope(error, backend, operation), json_output)
        return 1


if __name__ == "__main__":
    raise SystemExit(run())
