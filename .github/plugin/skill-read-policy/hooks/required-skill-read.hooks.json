{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --locked --script \"$PLUGIN_ROOT/hooks/required-skill-read.py\" check --repo .",
            "statusMessage": "Checking required skill reads",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "uv run --locked --script \"$PLUGIN_ROOT/hooks/required-skill-read.py\" init --repo .",
            "statusMessage": "Starting required-skill read tracking",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
