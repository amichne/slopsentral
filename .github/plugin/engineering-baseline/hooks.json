{
  "hooks": {
    "PostToolUse": [
      {
        "bash": "bash \"$PLUGIN_ROOT/hooks/agents-md-turn-refresh.sh\" record --repo .",
        "timeoutSec": 10,
        "type": "command"
      }
    ],
    "Stop": [
      {
        "bash": "bash \"$PLUGIN_ROOT/hooks/agents-md-turn-refresh.sh\" stop --repo .",
        "timeoutSec": 30,
        "type": "command"
      }
    ],
    "UserPromptSubmit": [
      {
        "bash": "bash \"$PLUGIN_ROOT/hooks/agents-md-turn-refresh.sh\" start --repo .",
        "timeoutSec": 10,
        "type": "command"
      }
    ]
  },
  "version": 1
}
