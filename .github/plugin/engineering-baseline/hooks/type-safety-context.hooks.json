{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 4000,
            "command": "python3 \"$PLUGIN_ROOT/hooks/inject-concept-context.py\" --concept type-safety",
            "statusMessage": "Loading type-safety context",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ]
  }
}
