{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$PLUGIN_ROOT/hooks/github-actions-await.py\" guard --repo .",
            "statusMessage": "Enforcing the AXI GitHub boundary",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|exec_command|mcp__.*github.*)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$PLUGIN_ROOT/hooks/github-actions-await.py\" stop --repo .",
            "statusMessage": "Awaiting a meaningful GitHub Actions event",
            "timeout": 3600,
            "type": "command"
          }
        ]
      }
    ]
  }
}
