{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 4000,
            "command": "python3 \"$PLUGIN_ROOT/hooks/inject-concept-context.py\" --concept schema-driven-design",
            "statusMessage": "Loading schema-design context",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ]
  }
}
