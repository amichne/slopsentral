#!/usr/bin/env python3
"""Non-interactive IntelliJ diagnostics evidence and configuration helper."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile
from typing import Any

MCP_OPTION = "-Didea.diagnostics.mcp.enabled=true"
IDE_PERF_OPTION = "-Djdk.attach.allowAttachSelf=true"
METHOD_RE = re.compile(
    r"^(?:[A-Za-z_$][\w$]*\.)+[A-Za-z_$][\w$]*#[A-Za-z_$][\w$]*$"
)


class EvidenceError(Exception):
    """A finite user-data or safety failure."""


def emit(payload: dict[str, Any], *, stream: Any = sys.stdout) -> None:
    json.dump(payload, stream, indent=2, sort_keys=True)
    stream.write("\n")


def load_capture(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise EvidenceError(f"cannot read diagnostics JSON {path}: {error}") from error
    if not isinstance(value, dict):
        raise EvidenceError(f"diagnostics JSON must be an object: {path}")
    for wrapper in ("diagnostics", "result"):
        nested = value.get(wrapper)
        if isinstance(nested, dict):
            value = nested
    return value


def numeric(value: Any) -> int | float | None:
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def delta(before: Any, during: Any) -> int | float | None:
    left, right = numeric(before), numeric(during)
    return None if left is None or right is None or left == -1 or right == -1 else right - left


def thread_key(item: dict[str, Any]) -> str:
    return f"{item.get('name', '<unnamed>')}#{item.get('id', '?')}"


def summarize_threads(before: dict[str, Any], during: dict[str, Any]) -> list[dict[str, Any]]:
    before_threads = {
        thread_key(item): item
        for item in before.get("topCpuThreads", [])
        if isinstance(item, dict)
    }
    result: list[dict[str, Any]] = []
    for item in during.get("topCpuThreads", []):
        if not isinstance(item, dict):
            continue
        key = thread_key(item)
        previous = before_threads.get(key, {})
        result.append(
            {
                "thread": key,
                "state": item.get("state"),
                "cpuDeltaNanos": item.get("cpuDeltaNanos"),
                "cpuDeltaChangeNanos": delta(
                    previous.get("cpuDeltaNanos"), item.get("cpuDeltaNanos")
                ),
                "blockedCountDelta": item.get("blockedCountDelta"),
                "waitedCountDelta": item.get("waitedCountDelta"),
                "nativeOperationHint": item.get("nativeOperationHint"),
                "topFrame": next(iter(item.get("stackTrace", [])), None),
            }
        )
    return result


def command_compare(args: argparse.Namespace) -> dict[str, Any]:
    before = load_capture(args.before)
    during = load_capture(args.during)
    before_process = before.get("process", {})
    during_process = during.get("process", {})
    before_states = before.get("threads", {}).get("stateCounts", {})
    during_states = during.get("threads", {}).get("stateCounts", {})
    states = sorted(set(before_states) | set(during_states))
    return {
        "type": "INTELLIJ_DIAGNOSTICS_COMPARISON",
        "process": {
            "beforeCpuLoad": before_process.get("processCpuLoad"),
            "duringCpuLoad": during_process.get("processCpuLoad"),
            "cpuLoadDelta": delta(
                before_process.get("processCpuLoad"), during_process.get("processCpuLoad")
            ),
            "beforeSystemCpuLoad": before_process.get("systemCpuLoad"),
            "duringSystemCpuLoad": during_process.get("systemCpuLoad"),
            "systemCpuLoadDelta": delta(
                before_process.get("systemCpuLoad"), during_process.get("systemCpuLoad")
            ),
        },
        "threadStateDeltas": {
            name: (during_states.get(name, 0) - before_states.get(name, 0)) for name in states
        },
        "topCpuThreadsDuring": summarize_threads(before, during),
        "rawDumpTruncated": bool(during.get("rawDumpTruncated", False)),
        "coroutineDumpEnabled": during.get("coroutineDumpEnabled"),
    }


def command_trace_plan(args: argparse.Namespace) -> dict[str, Any]:
    if not METHOD_RE.fullmatch(args.method):
        raise EvidenceError("--method must be a concrete FQCN#method without wildcards")
    return {
        "type": "INTELLIJ_IDE_PERF_TRACE_PLAN",
        "method": args.method,
        "uiPath": "Help > Diagnostic Tools > Tracer",
        "commands": ["clear", f"trace {args.method}", "reset"],
        "procedure": [
            "capture MCP baseline",
            "clear old IDE Perf data",
            "trace the concrete method",
            "reproduce the named action once",
            "record List and Tree evidence",
            "reset all tracepoints",
        ],
    }


def validate_vm_options_file(path: Path) -> os.stat_result:
    try:
        metadata = path.lstat()
    except FileNotFoundError as error:
        raise EvidenceError("custom VM-options file must already exist") from error
    if stat.S_ISLNK(metadata.st_mode):
        raise EvidenceError("refusing symlinked VM-options file")
    if not stat.S_ISREG(metadata.st_mode):
        raise EvidenceError("VM-options path must be a regular file")
    lowered_parts = [part.lower() for part in path.resolve().parts]
    lowered_name = path.name.lower()
    inside_app_bundle = ".app" in "".join(lowered_parts) and "contents" in lowered_parts and "bin" in lowered_parts
    installation_default = path.parent.name.lower() == "bin" and lowered_name in {
        "idea.vmoptions",
        "idea64.vmoptions",
        "studio.vmoptions",
        "studio64.vmoptions",
    }
    if inside_app_bundle or installation_default:
        raise EvidenceError("refusing installation-owned VM-options file; use a custom override")
    return metadata


def requested_options(enable: str) -> list[str]:
    if enable == "mcp":
        return [MCP_OPTION]
    if enable == "ide-perf":
        return [IDE_PERF_OPTION]
    return [MCP_OPTION, IDE_PERF_OPTION]


def command_vm_options(args: argparse.Namespace) -> dict[str, Any]:
    path = args.file.expanduser().absolute()
    metadata = validate_vm_options_file(path)
    try:
        original = path.read_text(encoding="utf-8")
    except OSError as error:
        raise EvidenceError(f"cannot read VM-options file: {error}") from error
    existing = set(original.splitlines())
    additions = [option for option in requested_options(args.enable) if option not in existing]
    base = {
        "type": "INTELLIJ_VM_OPTIONS_CHANGE",
        "file": str(path),
        "requested": requested_options(args.enable),
        "additions": additions,
    }
    if not additions:
        return {**base, "status": "NOOP", "applied": False, "backup": None}
    if not args.apply:
        return {**base, "status": "DRY_RUN", "applied": False, "backup": None}

    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    backup = path.with_name(f"{path.name}.backup.{timestamp}")
    shutil.copy2(path, backup, follow_symlinks=False)
    suffix = "" if original.endswith("\n") or not original else "\n"
    updated = f"{original}{suffix}{os.linesep.join(additions)}{os.linesep}"
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as temporary:
            temporary.write(updated)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.chmod(temporary_name, stat.S_IMODE(metadata.st_mode))
        os.replace(temporary_name, path)
    except Exception:
        Path(temporary_name).unlink(missing_ok=True)
        raise
    return {**base, "status": "APPLIED", "applied": True, "backup": str(backup)}


def command_ide_perf(args: argparse.Namespace) -> dict[str, Any]:
    target = args.app or args.launcher
    if not target.exists():
        raise EvidenceError(f"IDE target does not exist: {target}")
    if args.app:
        command = ["open", "-na", str(args.app), "--args", "installPlugins", "com.google.ide-perf"]
    else:
        if not target.is_file() or not os.access(target, os.X_OK):
            raise EvidenceError("--launcher must be an executable file")
        command = [str(args.launcher), "installPlugins", "com.google.ide-perf"]
    return {
        "type": "INTELLIJ_IDE_PERF_INSTALL_COMMAND",
        "executed": False,
        "argv": command,
        "shell": " ".join(json.dumps(part) for part in command),
    }


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="intellij_diagnostics")
    commands = root.add_subparsers(dest="command", required=True)

    compare = commands.add_parser("compare", help="compare two saved diagnostics MCP responses")
    compare.add_argument("--before", type=Path, required=True)
    compare.add_argument("--during", type=Path, required=True)
    compare.set_defaults(handler=command_compare)

    trace = commands.add_parser("trace-plan", help="emit a bounded IDE Perf method trace plan")
    trace.add_argument("--method", required=True)
    trace.set_defaults(handler=command_trace_plan)

    options = commands.add_parser("vm-options", help="preview or apply custom VM-option additions")
    options.add_argument("--file", type=Path, required=True)
    options.add_argument("--enable", choices=("mcp", "ide-perf", "both"), required=True)
    options.add_argument("--apply", action="store_true")
    options.set_defaults(handler=command_vm_options)

    install = commands.add_parser("ide-perf-command", help="emit, but do not execute, IDE Perf installation")
    target = install.add_mutually_exclusive_group(required=True)
    target.add_argument("--app", type=Path)
    target.add_argument("--launcher", type=Path)
    install.set_defaults(handler=command_ide_perf)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        emit(args.handler(args))
        return 0
    except EvidenceError as error:
        emit({"type": "INTELLIJ_DIAGNOSTICS_ERROR", "message": str(error)}, stream=sys.stderr)
        return 1
    except OSError as error:
        emit({"type": "INTELLIJ_DIAGNOSTICS_ERROR", "message": str(error)}, stream=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
