{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 8192,
            "command": "python3 \"$PLUGIN_ROOT/hooks/inject-instruction-context.py\" --instruction engineering-design",
            "statusMessage": "Loading engineering-excellence policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ]
  }
}
