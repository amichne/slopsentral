#!/usr/bin/env python3
"""Project JUnit XML into complete evidence or an explicit incomplete outcome.

`ok` means report parsing completed, not that the tests passed. Exit 1 means
missing or rejected evidence; test failures remain data in a parsed result.
"""
from __future__ import annotations

import argparse
from dataclasses import dataclass
from enum import Enum
import json
import math
from pathlib import Path
import sys
import xml.etree.ElementTree as ET


class ReportFailure(str, Enum):
    MISSING = "missing-reports"
    UNREADABLE = "unreadable-report"
    MALFORMED = "malformed-xml"
    UNSUPPORTED = "unsupported-root"
    INVALID_DATA = "invalid-data"


@dataclass(frozen=True)
class ParsedReport:
    suites: tuple[dict, ...]
    failures: tuple[dict, ...]


@dataclass(frozen=True)
class RejectedReport:
    kind: ReportFailure


def find_junit_xml_files(project_root: Path, module_filter: str | None):
    for xml_file in sorted(project_root.rglob("build/test-results/**/TEST-*.xml")):
        parts = xml_file.relative_to(project_root).parts
        module = ":" + ":".join(parts[:parts.index("build")])
        if module_filter is None or module == module_filter:
            yield xml_file, module


def parse_junit_xml(xml_path: Path, module: str) -> ParsedReport | RejectedReport:
    try:
        root = ET.parse(xml_path).getroot()
    except ET.ParseError:
        return RejectedReport(ReportFailure.MALFORMED)
    except OSError:
        return RejectedReport(ReportFailure.UNREADABLE)
    if root.tag not in ("testsuite", "testsuites"):
        return RejectedReport(ReportFailure.UNSUPPORTED)
    suites = [root] if root.tag == "testsuite" else list(root.iter("testsuite"))
    parsed_suites, all_failures = [], []
    for suite in suites:
        # Container suites have no direct test results; count their leaves once.
        if suite.find("testsuite") is not None:
            continue
        try:
            tests, failures, errors, skipped = (
                int(suite.get(key, "0")) for key in ("tests", "failures", "errors", "skipped")
            )
            duration = float(suite.get("time", "0"))
        except (ValueError, OverflowError):
            return RejectedReport(ReportFailure.INVALID_DATA)
        if (min(tests, failures, errors, skipped) < 0 or failures + errors + skipped > tests
                or not math.isfinite(duration) or duration < 0):
            return RejectedReport(ReportFailure.INVALID_DATA)
        for case in suite.findall("testcase"):
            failure = case.find("failure")
            if failure is None:
                failure = case.find("error")
            if failure is not None:
                all_failures.append({
                    "class": case.get("classname", "unknown"),
                    "method": case.get("name", "unknown"),
                    "module": module,
                    "message": failure.get("message", "")[:300],
                    "type": failure.get("type", "unknown"),
                    "stacktrace_head": "\n".join((failure.text or "").strip().splitlines()[:5])[:500],
                })
        parsed_suites.append({
            "name": suite.get("name", "unknown"), "module": module,
            "tests": tests, "failures": failures + errors, "skipped": skipped,
            "duration_seconds": round(duration, 3),
        })
    return ParsedReport(tuple(parsed_suites), tuple(all_failures))


def summarize(reports: list[ParsedReport]) -> dict:
    suites = [suite for report in reports for suite in report.suites]
    total = sum(suite["tests"] for suite in suites)
    failed = sum(suite["failures"] for suite in suites)
    skipped = sum(suite["skipped"] for suite in suites)
    return {
        "total": total, "passed": total - failed - skipped, "failed": failed,
        "skipped": skipped,
        "duration_seconds": round(sum(suite["duration_seconds"] for suite in suites), 3),
        "suites": suites,
        "failures": [failure for report in reports for failure in report.failures],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("project_root", type=Path)
    parser.add_argument("--module")
    args = parser.parse_args()
    root = args.project_root.resolve()
    reports, issues = [], []
    try:
        if not root.is_dir():
            raise FileNotFoundError(root)
        files = list(find_junit_xml_files(root, args.module))
    except OSError:
        files = []
        issues.append({"kind": ReportFailure.UNREADABLE.value, "path": "."})
    for xml_path, module in files:
        result = parse_junit_xml(xml_path, module)
        match result:
            case ParsedReport():
                reports.append(result)
            case RejectedReport(kind):
                issues.append({"kind": kind.value, "path": xml_path.relative_to(root).as_posix()})
    if not files and not issues:
        issues.append({"kind": ReportFailure.MISSING.value, "path": "."})
    if issues:
        payload = {
            "ok": False, "status": "incomplete" if files else "unavailable",
            "errors": issues, "parsedReportCount": len(reports),
            "partial": summarize(reports),
        }
    else:
        payload = {"ok": True, "status": "parsed", "parsedReportCount": len(reports), **summarize(reports)}
    print(json.dumps(payload, indent=2, allow_nan=False))
    return 1 if issues else 0


if __name__ == "__main__":
    sys.exit(main())
