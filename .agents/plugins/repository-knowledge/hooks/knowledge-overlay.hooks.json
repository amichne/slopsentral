{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 8192,
            "command": "uv run --locked --script \"$PLUGIN_ROOT/hooks/knowledge-overlay.py\"",
            "statusMessage": "Loading registered repository knowledge guidance",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ]
  }
}
