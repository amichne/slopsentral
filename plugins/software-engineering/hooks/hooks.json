{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" uv run --locked --script \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instruction-context.py\" --instruction agent-execution --instruction engineering-design",
            "statusMessage": "Loading software-engineering policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ]
  }
}
