{
  "name": "slopsentral",
  "version": "0.1.0",
  "description": "Portable lifecycle management for Slopsentral Codex profiles",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "slopsentral": "tools/slopsentral.mjs"
  },
  "files": [
    "README.md",
    "docs/profile-lifecycle.md",
    "source/adaptable.marketplace.json",
    "source/profiles/*.json",
    "source/schemas/profiles/*.json",
    "tools/profile-lifecycle.mjs",
    "tools/slopsentral.mjs",
    "tools/validate-profile-contracts.mjs"
  ],
  "scripts": {
    "test": "node --test tools/tests/*.test.mjs",
    "validate:profile-contracts": "node tools/validate-profile-contracts.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
